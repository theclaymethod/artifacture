{
  "name": "artifacture-v2",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter './packages/*' build",
    "shaders": "pnpm --filter @artifacture/gpu run shaders:build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "doctor": "vgpu doctor"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vgpu/wgsl": "^0.6.0",
    "playwright": "^1.60.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vgpu": "^0.6.0",
    "vitest": "^4.1.0"
  }
}
