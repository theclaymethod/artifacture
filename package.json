{
  "name": "artifacture",
  "version": "0.10.0",
  "type": "module",
  "description": "Charts, diagrams, and presentations from editable source, exported as standalone HTML.",
  "keywords": [
    "claude-code-plugin",
    "agent-skill"
  ],
  "license": "MIT",
  "bin": {
    "artifacture": "scripts/artifacture.mjs",
    "artifacture-preview": "plugins/visual-explainer/scripts/preview.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "components": "node scripts/artifacture.mjs",
    "build:skill-runtime": "node scripts/build-skill-runtime.mjs",
    "check:skill-runtime": "node scripts/build-skill-runtime.mjs --check",
    "prepack": "npm run check:diagram-examples && npm run check:pr-lens-examples && npm run check:chalkboard-examples && node scripts/components/check.mjs && npm run build:skill-runtime",
    "lint": "oxlint .",
    "ve:export": "node scripts/ve-mdx/export.mjs",
    "ve:export-static": "node scripts/ve-mdx/export-static.mjs",
    "ve:check": "node scripts/ve-mdx/check.mjs",
    "ve:check-integrity": "node scripts/ve-mdx/check-integrity.mjs",
    "ve:verify": "node plugins/visual-explainer/scripts/verify/ve-verify.mjs",
    "ve:finalize": "node plugins/visual-explainer/scripts/verify/ve-finalize.mjs",
    "ve:eval": "node evals/run.mjs",
    "ve:eval-product": "node evals/product-benchmark/check.mjs --json",
    "ve:manifest-product-run": "node evals/product-benchmark/run-manifest.mjs",
    "ve:prepare-product-review": "node evals/product-benchmark/prepare-review.mjs",
    "ve:generate-product-benchmark": "node evals/model-matrix/run-matrix.mjs --models codex --tasks arch-diagram,code-walkthrough,comparison-table,explain-diff,slide-deck,project-recap",
    "ve:eval-presentation": "node evals/run-presentation.mjs",
    "ve:render-visual-model-corpus": "node evals/visual-model-policy/render-corpus.mjs",
    "ve:run-visual-model-eval": "node evals/visual-model-policy/run.mjs",
    "ve:aggregate-visual-model-eval": "node evals/visual-model-policy/aggregate.mjs",
    "ve:merge-visual-model-measurements": "node evals/visual-model-policy/merge.mjs",
    "ve:select-visual-model-policy": "node evals/visual-model-policy/select.mjs",
    "check:manifests": "node scripts/check-manifests.mjs",
    "typecheck": "tsc --noEmit",
    "check:fast": "npm run check:skill-runtime && npm test && npm run typecheck && npm run check:manifests && npm run ve:check",
    "check": "node evals/check-with-budget.mjs",
    "check:release": "npm run check && node evals/product-benchmark/check.mjs --json",
    "ve:learn": "node scripts/ve-mdx/learn.mjs",
    "test": "npm run test:e2e",
    "ve:archify": "node scripts/archify.mjs",
    "ve:chart": "node scripts/lieflat-chart.mjs",
    "ve:video-collection": "node plugins/visual-explainer/scripts/video-collection.mjs",
    "ve:graphic-video": "node scripts/ve-mdx/graphic-video.mjs",
    "test:e2e": "node --test scripts/narrated-film-tools.test.mjs scripts/ve-mdx/export-react-singleton.test.mjs evals/mechanics-mode.test.mjs evals/product-benchmark/check.test.mjs evals/deck-review-set.browser.test.mjs plugins/visual-explainer/scripts/embed-media.test.mjs plugins/visual-explainer/scripts/export-slides-pdf.test.mjs plugins/visual-explainer/scripts/preview.test.mjs",
    "build:diagram-examples": "node scripts/build-diagram-examples.mjs",
    "check:diagram-examples": "node scripts/build-diagram-examples.mjs --check",
    "build:pr-lens-examples": "node scripts/build-pr-lens-examples.mjs",
    "check:pr-lens-examples": "node scripts/build-pr-lens-examples.mjs --check",
    "build:chalkboard-examples": "node scripts/build-chalkboard-examples.mjs",
    "check:chalkboard-examples": "node scripts/build-chalkboard-examples.mjs --check"
  },
  "dependencies": {
    "@coldtea/pr-lens-cli": "0.13.0",
    "@coldtea/pr-lens-renderer": "0.3.2",
    "@coldtea/pr-lens-schema": "0.7.0",
    "@lucasmarkes/hairline": "0.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "d3-dag": "1.2.2",
    "ffmpeg-static": "5.3.0",
    "gsap": "3.14.2",
    "linkedom": "0.18.12",
    "playwright": "1.60.0",
    "playwright-core": "1.60.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shaders": "4.0.0",
    "shiki": "4.3.1",
    "svg-path-properties": "2.1.0",
    "tailwindcss": "^4.3.0",
    "three": "0.186.1",
    "vite": "^8.0.12"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "oxlint": "^1.79.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theclaymethod/artifacture.git"
  }
}
