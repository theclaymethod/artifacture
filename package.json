{
  "name": "artifacture-v2",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter './packages/*' build",
    "shaders": "pnpm --filter @artifacture/gpu run shaders:build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "doctor": "vgpu doctor",
    "spirula:colab": "node scripts/spirula-colab.mjs",
    "sharp:colab": "node scripts/sharp-colab.mjs",
    "physgs:colab": "node scripts/physgs-colab.mjs",
    "da3:colab": "node scripts/da3-colab.mjs",
    "mcmc:colab": "node scripts/mcmc-colab.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vgpu/wgsl": "^0.6.0",
    "artifacture": "workspace:*",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vgpu": "^0.6.0",
    "vitest": "^5.1.1"
  }
}
