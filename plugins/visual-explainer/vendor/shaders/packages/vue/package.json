{
  "name": "shaders-vue",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate": "tsx ../core/scripts/generate-components.ts --framework=vue",
    "prebuild": "pnpm run clean && pnpm run generate",
    "build": "echo '⚙️  Building vue package...' && vite build"
  },
  "dependencies": {
    "shaders-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vite-plugin-externalize-deps": "^0.10.0",
    "vite": "npm:rolldown-vite@7.1.16"
  }
}
